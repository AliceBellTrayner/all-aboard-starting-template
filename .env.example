# Copy to .env and fill in real values. Never commit .env.

# Link for the IT@LBG workplace adjustments portal (Tools > Choose your peripherals)
NEXT_PUBLIC_IT_SUPPORT_URL=https://example.com/it-support

# Browser key restricted to your app's HTTP referrers and the Maps Embed API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Set the colleague's full office address. Defaults to their city if unset.
NEXT_PUBLIC_OFFICE_ADDRESS=
